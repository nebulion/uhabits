<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Lato, by Łukasz Dziedzic. SIL Open Font License 1.1.
  ~
  ~ Taken from Mudita's own design system, mudita/MMD (Apache 2.0), where
  ~ TypographyMMD declares exactly this family. Their whole type scale is set
  ~ in it, so matching the family is what makes this app look native on a
  ~ Kompakt rather than like a stock Android app running on one.
  -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/lato_thin"
        android:fontStyle="normal"
        android:fontWeight="100" />
    <font
        android:font="@font/lato_thin_italic"
        android:fontStyle="italic"
        android:fontWeight="100" />
    <font
        android:font="@font/lato_light"
        android:fontStyle="normal"
        android:fontWeight="300" />
    <font
        android:font="@font/lato_light_italic"
        android:fontStyle="italic"
        android:fontWeight="300" />
    <font
        android:font="@font/lato_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/lato_italic"
        android:fontStyle="italic"
        android:fontWeight="400" />
    <font
        android:font="@font/lato_semi_bold"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/lato_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
    <font
        android:font="@font/lato_bold_italic"
        android:fontStyle="italic"
        android:fontWeight="700" />
    <font
        android:font="@font/lato_black"
        android:fontStyle="normal"
        android:fontWeight="900" />
    <font
        android:font="@font/lato_black_italic"
        android:fontStyle="italic"
        android:fontWeight="900" />
</font-family>
