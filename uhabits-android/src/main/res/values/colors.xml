<resources>
    <!--
      ~ The Material colour palettes were removed with the E Ink redesign; see
      ~ einkPalette below.
      -->

    <!-- Hairline rules. Structure only, never text. -->
    <color name="eink_rule">#BDBDBD</color>

    <!--
      ~ There is no E Ink palette. The panel cannot render hue, so every habit
      ~ is drawn in the same black ink and told apart by its name and position.
      ~ The array keeps twenty entries because the colour picker and the widget
      ~ code index into it directly.
      -->
    <array name="einkPalette">
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
        <item>@color/black</item>
    </array>

    <!--
      The launcher icon's background. This was Material blue (#1976D2), which
      is the one piece of colour the app still put on screen: the panel cannot
      render hue, so the OS composited it to whatever grey its own dithering
      chose, on a home screen that is otherwise pure black on white.
    -->
    <color name="ic_launcher_background">#FFFFFF</color>
    <color name="color_background">@color/white</color>
</resources>