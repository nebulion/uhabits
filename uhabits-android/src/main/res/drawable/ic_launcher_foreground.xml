<!--
  The launcher icon: this app's own loop mark, in the frame MuditaOS puts every
  icon in.
  
  Every icon on the Kompakt's home screen is the same object, a rounded square
  outlined in one black stroke holding a single line-art glyph on white, so
  this is that. What it holds is not a new drawing: it is the loop from the
  app's own logo, lifted from ic_notification.xml, which is the same mark the
  icon has always carried. Only its treatment changed. Before this it was five
  densities of PNG with a drop shadow baked in, which is why both the launcher
  and the startup screen showed a grey smear rather than a mark.
  
  An adaptive icon is a 108dp canvas whose outer 18dp can be cropped by
  whatever mask a launcher applies. The frame runs 20..88 and the glyph
  34..74, so both clear the crop even under a circular mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="108dp"
        android:height="108dp"
        android:viewportWidth="108"
        android:viewportHeight="108">

    <!-- The frame every MuditaOS icon sits in. -->
    <path
        android:pathData="M36,20 L72,20 A16,16 0 0 1 88,36 L88,72 A16,16 0 0 1 72,88 L36,88 A16,16 0 0 1 20,72 L20,36 A16,16 0 0 1 36,20 Z"
        android:strokeColor="#000000"
        android:strokeWidth="4"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>

    <!--
      The loop. In the original this subpath is knocked out of a filled disc,
      so as a shape it is already the stroke of the mark rather than its
      silhouette, and filling it black on white draws the same line art the
      logo has always been.
    -->
    <group
        android:scaleX="0.14159"
        android:scaleY="0.14159"
        android:translateX="20.846"
        android:translateY="20.343">
        <path
            android:fillColor="#000000"
            android:pathData="M209,101.5c6,3.1 6,3.2 6,50.7 0,41.1 -0.1,43.4 -1.9,46.2 -2.5,3.7 -5.7,5.5 -9.8,5.6 -3.8,-0 -7,-2.6 -22.1,-18l-10.4,-10.5 -2.4,3c-23.6,28.6 -28.4,67.7 -12.3,99.7 12.2,24.2 34.2,42 59.9,48.4 10.5,2.7 33.5,2.6 44,-0 32,-8 58.6,-34.6 66.6,-66.6 2.9,-11.4 2.6,-34.6 -0.4,-45.9 -4.9,-17.9 -14.7,-33 -30.5,-46.9 -6.4,-5.6 -5.7,-7.3 9.1,-21.8 14.7,-14.5 16.3,-15.8 19.2,-14.9 2.8,0.9 17.6,15.7 22.9,22.9 13.1,17.7 21.6,36.1 25.9,56 2.2,10.3 2.6,14.6 2.6,28.6 0,23.7 -3.4,38.8 -13.4,59.5 -7.2,15.1 -14.2,24.8 -27,37.5 -12.7,12.8 -22.4,19.8 -37.5,27 -20.5,9.9 -35.8,13.3 -59,13.4 -18.2,-0 -27.7,-1.5 -44.5,-7 -40.2,-13.3 -73.8,-47.1 -87,-87.4 -14.1,-43 -6.2,-89.6 21.2,-126 3.1,-4.2 6.6,-8.4 7.8,-9.5l2.1,-1.9 -12.7,-12.7c-12.3,-12.3 -12.7,-12.8 -13.2,-17.7 -0.5,-5.8 0.7,-8.6 5.1,-11.2 3,-1.9 5.4,-2 46,-2 36.3,-0 43.2,0.2 45.7,1.5z"/>
