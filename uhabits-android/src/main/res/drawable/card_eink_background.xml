<!--
  ~ Rows are divided by a dotted black rule.
  ~
  ~ This is what Mudita Notes does on a Kompakt: a heavy solid rule closes the
  ~ header, and then the note rows below it are separated by dotted hairlines.
  ~ The two weights say different things — solid for structure, dotted for
  ~ repetition — without either of them resorting to grey, which is what the
  ~ light hairline used here previously was doing.
  -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item
        android:bottom="0dp"
        android:gravity="bottom"
        android:height="1dp">
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="@color/black"
                android:dashWidth="2dp"
                android:dashGap="3dp" />
        </shape>
    </item>
</layer-list>
