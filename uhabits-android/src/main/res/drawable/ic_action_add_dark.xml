<!--
  ~ "Add habit", drawn the way Mudita marks a primary action.
  ~
  ~ On a Kompakt, Notes puts its "+" in a solid black rounded square with the
  ~ glyph knocked out in white, while search and edit beside it stay as bare
  ~ black strokes; Calculator does the same thing with "=" against its
  ~ outlined operator keys. Inversion is the emphasis mechanism, since weight
  ~ and colour are both unavailable on this panel.
  -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Filled black square, lightly rounded as on the Kompakt. -->
    <path
        android:fillColor="@color/black"
        android:pathData="M3,5.5A2.5,2.5 0 0,1 5.5,3H18.5A2.5,2.5 0 0,1 21,5.5V18.5A2.5,2.5 0 0,1 18.5,21H5.5A2.5,2.5 0 0,1 3,18.5Z" />

    <!-- Plus knocked out in white. -->
    <path
        android:fillColor="@color/white"
        android:pathData="M11,7h2v4h4v2h-4v4h-2v-4H7v-2h4z" />
</vector>
