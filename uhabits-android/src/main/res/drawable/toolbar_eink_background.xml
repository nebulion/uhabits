<!--
  ~ White header closed by a heavy black rule.
  ~
  ~ Measured off a Mudita Kompakt: both Notes and Calculator separate the
  ~ header band from the body with a solid black rule 3dp, matching
  ~ DividerDefaultsMMD.Thickness in mudita/MMD. A hairline reads as an artefact
  ~ at that size; the heavy rule is what makes the band read as a band.
  -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/black" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
        </shape>
    </item>
</layer-list>
